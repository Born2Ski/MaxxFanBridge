#!/bin/bash
#
# SetupHelper setup script for MaxxFanBridge: MaxxFan cards in the Venus OS switch pane.
# PackageManager (Settings → PackageManager) runs this to install, uninstall, and reinstall
# after a Venus OS update. By hand: /data/MaxxFanBridge/setup
#
# What it installs: the dbus-maxxfan-bridge service (services/), and the gui-v2 plugin card
# (gui-plugin/MaxxFanBridge.json) in /data/apps, where gui-v2 1.4.6 and later find it; older
# gui-v2 ignores it. Nothing in Venus OS itself is modified. The settings live in /data/setupOptions/MaxxFanBridge (config.ini, the lid
# memory, saved presets); updates leave them alone. Removing the package deletes them, and
# the cards' settings in Venus OS, so a reinstall starts like new (owner's choice).

if [ ! -f "/data/SetupHelper/HelperResources/IncludeHelpers" ]; then
    echo "MaxxFanBridge needs SetupHelper: https://github.com/kwindrem/SetupHelper"
    exit 1
fi

#### following line incorporates helper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources

if [ "$scriptAction" == 'NONE' ]; then
    standardActionPrompt
fi

if [ "$scriptAction" == 'INSTALL' ]; then
    # the driver also finds a paho copied into the settings folder, which updates leave alone
    if ! PYTHONPATH="$setupOptionsDir" python3 -c "import paho.mqtt.client" 2> /dev/null; then
        setInstallFailed $EXIT_ERROR "python3 paho-mqtt is missing; copy it to $setupOptionsDir (see venus/README.md)"
    fi
fi

if [ "$scriptAction" == 'INSTALL' ] && ! $installFailed ; then
    mkdir -p "$setupOptionsDir"
    if [ ! -f "$setupOptionsDir/config.ini" ]; then
        cp "$scriptDir/venus/dbus-maxxfan-bridge/config.default.ini" "$setupOptionsDir/config.ini"
        logMessage "created $setupOptionsDir/config.ini from the defaults"
    fi
    logMessage "settings: $setupOptionsDir/config.ini; after editing: svc -t /service/dbus-maxxfan-bridge"
fi

# The plugin card: copied, and enabled, as gui-v2's plugin guide says. gui-v2 notices it by itself.
pluginDir="/data/apps/available/MaxxFanBridge"
if [ "$scriptAction" == 'INSTALL' ] && ! $installFailed ; then
    mkdir -p "$pluginDir/gui-v2" /data/apps/enabled
    cp "$scriptDir/gui-plugin/MaxxFanBridge.json" "$pluginDir/gui-v2/MaxxFanBridge.json"
    ln -sfn "$pluginDir" /data/apps/enabled/MaxxFanBridge
    logMessage "plugin card installed; it shows with gui-v2 1.4.6 or later"
fi
if [ "$scriptAction" == 'UNINSTALL' ]; then
    rm -f /data/apps/enabled/MaxxFanBridge
    rm -rf "$pluginDir"
fi

# A real removal, not an install that failed and is being rolled back (SetupHelper then also
# sets UNINSTALL; it tells them apart the same way). Updates never get here: they only install.
if [ "$scriptAction" == 'UNINSTALL' ] && ! $installFailed ; then
    svc -d /service/dbus-maxxfan-bridge 2> /dev/null  # nothing may write while we forget
    logMessage "$(python3 "$scriptDir/venus/dbus-maxxfan-bridge/forget.py" "$setupOptionsDir" 2>&1)"
fi

# Installs or removes services/dbus-maxxfan-bridge according to scriptAction (and removes it
# again if the install failed). Never returns.
endScript INSTALL_SERVICES
