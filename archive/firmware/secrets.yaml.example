# Copy to secrets.yaml and fill in. secrets.yaml stays on your computer.
wifi_ssid: "your-van-wifi"             # your van router (or a Cerbo's own access point)
wifi_password: "change-me"
mqtt_broker: "192.168.1.50"            # the Venus device's address on that network
ota_password: "change-me-too"
# Option E only (vanturtle-board.yaml). Empty = no login. With a Venus OS security profile
# that asks for a password, any user name and that password (archive/hardware/option-e-vanturtle-esp32.md).
mqtt_username: ""
mqtt_password: ""
